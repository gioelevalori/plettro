<Window x:Class="Plettro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plettro — Accordatore e Metronomo"
        Height="760" Width="980" MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/plettro.ico"
        Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="4,0,4,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="Sessione di pratica" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="SessionText" Text="00:00:00" FontSize="20" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="SessionButton" Content="Avvia" Width="84" Margin="0,0,6,0" Focusable="False" Click="SessionButton_Click"/>
                <Button Content="Azzera" Width="84" Focusable="False" Click="SessionReset_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Plettro" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="accordatore · metronomo · allenamento" FontSize="14" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Bottom" Margin="12,0,0,6"/>
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="Tabs" Grid.Row="1">

            <!-- ======================= TUNER ======================= -->
            <TabItem Header="🎸  Accordatore">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,20,6">
                            <TextBlock Style="{StaticResource Caption}" Text="Accordatura"/>
                            <ComboBox x:Name="TuningCombo" Width="290" SelectionChanged="TuningCombo_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,20,6">
                            <TextBlock Style="{StaticResource Caption}" Text="Diapason (La4)"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−" Width="40" Focusable="False" Click="A4Down_Click"/>
                                <TextBlock x:Name="A4Text" Text="440 Hz" Width="78" TextAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                                <Button Content="+" Width="40" Focusable="False" Click="A4Up_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource Caption}" Text="Modalità"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AutoModeButton" Content="Automatica (tutte le corde)" Focusable="False" Margin="0,0,6,0" Click="AutoMode_Click"/>
                                <Button x:Name="RefToneButton" Content="🔊  Nota di riferimento" Focusable="False" Click="RefTone_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Viewbox Stretch="Uniform" Margin="0,4,0,0">
                                <Canvas x:Name="Gauge" Width="500" Height="290"/>
                            </Viewbox>
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,-6,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="NoteText" Text="–" FontSize="76" FontWeight="Bold" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="OctaveText" Text="" FontSize="26" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,14"/>
                                </StackPanel>
                                <TextBlock x:Name="NoteItText" Text="Suona una corda" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,-10,0,4"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="FreqText" Text="— Hz" FontSize="15" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" Width="120" TextAlignment="Right"/>
                                    <TextBlock Text="  ·  " FontSize="15" Foreground="{StaticResource MutedBrush}"/>
                                    <TextBlock x:Name="CentsText" Text="— cent" FontSize="15" FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" Width="120"/>
                                </StackPanel>
                                <TextBlock x:Name="HintText" Text=" " FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource Caption}" Text="Corde — clicca una corda per bloccare l'accordatore su quella nota (utile per accordature ribassate)" HorizontalAlignment="Center"/>
                        <StackPanel x:Name="StringsPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ingresso" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Grid Grid.Column="1" Height="14" VerticalAlignment="Center">
                                <Border CornerRadius="7" Background="#22FFFFFF"/>
                                <Border x:Name="LevelBar" CornerRadius="7" HorizontalAlignment="Left" Width="0" Background="{StaticResource GoodBrush}"/>
                            </Grid>
                            <TextBlock x:Name="LevelText" Grid.Column="2" Text="-∞ dB" Width="70" TextAlignment="Right" FontFamily="Consolas" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Ellipse x:Name="ClipLight" Width="14" Height="14" Fill="#33FF5A5A"/>
                                <TextBlock Text="CLIP" Margin="6,0,0,0" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="InputInfoText" Grid.Row="1" Grid.ColumnSpan="4" Text="Nessun ingresso" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================= METRONOME ======================= -->
            <TabItem Header="⏱  Metronomo">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                        <Grid>
                            <Border x:Name="FlashOverlay" CornerRadius="11" Margin="-16" Background="{StaticResource AccentBrush}" Opacity="0" IsHitTestVisible="False"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="BpmText" Text="100" FontSize="110" FontWeight="Bold" HorizontalAlignment="Center"
                                           Background="Transparent" MouseWheel="Bpm_MouseWheel" ToolTip="Usa la rotellina del mouse per cambiare BPM"/>
                                <TextBlock x:Name="TempoNameText" Text="BPM · Andante" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="17" Margin="0,-12,0,18"/>

                                <Grid Margin="0,0,0,10" MaxWidth="520">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="−5" Width="48" Focusable="False" Click="BpmMinus5_Click"/>
                                    <Button Grid.Column="1" Content="−1" Width="48" Margin="6,0,0,0" Focusable="False" Click="BpmMinus1_Click"/>
                                    <Slider x:Name="BpmSlider" Grid.Column="2" Minimum="20" Maximum="300" Value="100" Margin="12,0" VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False" ValueChanged="BpmSlider_ValueChanged"/>
                                    <Button Grid.Column="3" Content="+1" Width="48" Margin="0,0,6,0" Focusable="False" Click="BpmPlus1_Click"/>
                                    <Button Grid.Column="4" Content="+5" Width="48" Focusable="False" Click="BpmPlus5_Click"/>
                                </Grid>

                                <Button x:Name="TapButton" Content="👆  Tap tempo (T)" HorizontalAlignment="Center" Padding="18,6" Focusable="False" Margin="0,4,0,22" Click="Tap_Click"/>

                                <WrapPanel x:Name="BeatDotsPanel" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Clicca sui pallini per cambiare: accento → normale → muto" HorizontalAlignment="Center" Style="{StaticResource Caption}" Margin="0,0,0,22"/>

                                <Button x:Name="StartButton" Content="▶   Avvia  (Spazio)" HorizontalAlignment="Center" FontSize="20" Padding="44,12"
                                        Style="{DynamicResource AccentButtonStyle}" Focusable="False" Click="StartStop_Click"/>
                                <TextBlock x:Name="BarText" Text=" " HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Ritmo e suono"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="Battiti per battuta"/>
                                    <ComboBox x:Name="BeatsCombo" HorizontalAlignment="Stretch" Margin="0,0,0,10" SelectionChanged="BeatsCombo_SelectionChanged"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="Suddivisione"/>
                                    <ComboBox x:Name="SubdivCombo" HorizontalAlignment="Stretch" Margin="0,0,0,10" SelectionChanged="SubdivCombo_SelectionChanged">
                                        <ComboBoxItem Content="Quarti (♩)" Tag="1"/>
                                        <ComboBoxItem Content="Ottavi (♪♪)" Tag="2"/>
                                        <ComboBoxItem Content="Terzine" Tag="3"/>
                                        <ComboBoxItem Content="Sedicesimi" Tag="4"/>
                                        <ComboBoxItem Content="Sestine" Tag="6"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Caption}" Text="Suono"/>
                                    <ComboBox x:Name="SoundCombo" HorizontalAlignment="Stretch" Margin="0,0,0,10" SelectionChanged="SoundCombo_SelectionChanged">
                                        <ComboBoxItem Content="Beep elettronico"/>
                                        <ComboBoxItem Content="Legno (woodblock)"/>
                                        <ComboBoxItem Content="Click secco"/>
                                    </ComboBox>
                                    <DockPanel>
                                        <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Text="80%" Width="44" TextAlignment="Right"/>
                                        <TextBlock Style="{StaticResource Caption}" Text="Volume metronomo"/>
                                    </DockPanel>
                                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" Focusable="False" ValueChanged="VolumeSlider_ValueChanged"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="TrainerCheck" Content="Allenatore di velocità" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" Focusable="False" Click="Trainer_Changed"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Aumenta il tempo automaticamente mentre suoni, fino al BPM obiettivo."/>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock x:Name="TrainerTargetText" DockPanel.Dock="Right" Text="140" Width="44" TextAlignment="Right"/>
                                        <TextBlock Text="BPM obiettivo"/>
                                    </DockPanel>
                                    <Slider x:Name="TrainerTargetSlider" Minimum="30" Maximum="300" Value="140" IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False" ValueChanged="Trainer_Changed"/>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock x:Name="TrainerStepText" DockPanel.Dock="Right" Text="+5" Width="44" TextAlignment="Right"/>
                                        <TextBlock Text="Incremento BPM"/>
                                    </DockPanel>
                                    <Slider x:Name="TrainerStepSlider" Minimum="1" Maximum="20" Value="5" IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False" ValueChanged="Trainer_Changed"/>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock x:Name="TrainerEveryText" DockPanel.Dock="Right" Text="4" Width="44" TextAlignment="Right"/>
                                        <TextBlock Text="Ogni quante battute"/>
                                    </DockPanel>
                                    <Slider x:Name="TrainerEverySlider" Minimum="1" Maximum="16" Value="4" IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False" ValueChanged="Trainer_Changed"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <CheckBox x:Name="GapCheck" Content="Battute mute (prova del tempo)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" Focusable="False" Click="Gap_Changed"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Il metronomo suona per alcune battute e poi tace: continua a suonare e verifica se rientri a tempo."/>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock x:Name="GapPlayText" DockPanel.Dock="Right" Text="3" Width="44" TextAlignment="Right"/>
                                        <TextBlock Text="Battute suonate"/>
                                    </DockPanel>
                                    <Slider x:Name="GapPlaySlider" Minimum="1" Maximum="8" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False" ValueChanged="Gap_Changed"/>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock x:Name="GapMuteText" DockPanel.Dock="Right" Text="1" Width="44" TextAlignment="Right"/>
                                        <TextBlock Text="Battute mute"/>
                                    </DockPanel>
                                    <Slider x:Name="GapMuteSlider" Minimum="1" Maximum="8" Value="1" IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False" ValueChanged="Gap_Changed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ======================= SETTINGS ======================= -->
            <TabItem Header="⚙  Impostazioni audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Dispositivi"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="Ingresso (dove è collegata la chitarra)"/>
                                    <ComboBox x:Name="InputCombo" HorizontalAlignment="Stretch" Margin="0,0,0,10" SelectionChanged="InputCombo_SelectionChanged"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="Canale di ingresso"/>
                                    <ComboBox x:Name="ChannelCombo" HorizontalAlignment="Stretch" Margin="0,0,0,10" SelectionChanged="ChannelCombo_SelectionChanged">
                                        <ComboBoxItem Content="Automatico (sceglie il canale con segnale)"/>
                                        <ComboBoxItem Content="Ingresso 1 — sinistro (microfono XLR)"/>
                                        <ComboBoxItem Content="Ingresso 2 — destro (strumento / chitarra)"/>
                                        <ComboBoxItem Content="Mix 1 + 2"/>
                                    </ComboBox>
                                    <TextBlock Style="{StaticResource Caption}" Text="Uscita (metronomo e note di riferimento)"/>
                                    <ComboBox x:Name="OutputCombo" HorizontalAlignment="Stretch" Margin="0,0,0,12" SelectionChanged="OutputCombo_SelectionChanged"/>
                                    <Button Content="↻  Aggiorna elenco dispositivi" HorizontalAlignment="Left" Focusable="False" Click="RefreshDevices_Click"/>
                                    <TextBlock x:Name="DeviceStatusText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Accordatore"/>
                                    <DockPanel>
                                        <TextBlock x:Name="GateText" DockPanel.Dock="Right" Text="-55 dB" Width="60" TextAlignment="Right"/>
                                        <TextBlock Text="Soglia di sensibilità (più bassa = più sensibile)"/>
                                    </DockPanel>
                                    <Slider x:Name="GateSlider" Minimum="-80" Maximum="-25" Value="-55" IsSnapToTickEnabled="True" TickFrequency="1" Focusable="False" Margin="0,4,0,10" ValueChanged="GateSlider_ValueChanged"/>
                                    <DockPanel>
                                        <TextBlock x:Name="ToneVolText" DockPanel.Dock="Right" Text="50%" Width="60" TextAlignment="Right"/>
                                        <TextBlock Text="Volume note di riferimento"/>
                                    </DockPanel>
                                    <Slider x:Name="ToneVolSlider" Minimum="0" Maximum="100" Value="50" Focusable="False" Margin="0,4,0,10" ValueChanged="ToneVolSlider_ValueChanged"/>
                                    <CheckBox x:Name="ItalianCheck" Content="Mostra anche i nomi italiani delle note (Do, Re, Mi…)" IsChecked="True" Focusable="False" Click="ItalianCheck_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Consigli per la Scarlett Solo (3ª gen)"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="21">
                                    <Run FontWeight="SemiBold">1. Collega la chitarra all'ingresso 2</Run> (jack frontale a destra, "INST") e premi il tasto <Run FontWeight="SemiBold">INST</Run>: si accende di rosso e adatta l'impedenza ai pickup della chitarra.
                                    <LineBreak/><LineBreak/>
                                    <Run FontWeight="SemiBold">2. Regola il GAIN</Run>: plettra forte una corda. L'anello attorno alla manopola deve restare verde, al massimo ambra sui colpi più forti. Se diventa rosso (o qui si accende "CLIP"), abbassa il gain.
                                    <LineBreak/><LineBreak/>
                                    <Run FontWeight="SemiBold">3. Canale</Run>: Windows vede la Scarlett come un dispositivo stereo "Analogue 1 + 2". L'ingresso 1 (mic) è il canale sinistro, l'ingresso 2 (chitarra) è il destro. In modalità automatica Plettro sceglie da solo.
                                    <LineBreak/><LineBreak/>
                                    <Run FontWeight="SemiBold">4. Ascolto</Run>: per sentire la chitarra in cuffia usa il tasto <Run FontWeight="SemiBold">Direct Monitor</Run> sulla scheda (latenza zero). Imposta l'uscita su "Speakers (Focusrite USB Audio)" per sentire il metronomo nelle stesse cuffie.
                                    <LineBreak/><LineBreak/>
                                    <Run FontWeight="SemiBold">5. Se non vedi la scheda</Run>: collegala, installa Focusrite Control dal sito Focusrite e premi "Aggiorna elenco dispositivi". Se un'altra app (DAW) usa la scheda in modalità esclusiva/ASIO, chiudila o cambia le sue impostazioni.
                                    <LineBreak/><LineBreak/>
                                    <Run FontWeight="SemiBold">Scorciatoie</Run>: Spazio = avvia/ferma metronomo · ↑/↓ = ±1 BPM (Maiusc = ±5) · T = tap tempo · F1/F2/F3 = cambia scheda.
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="4,8,4,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text=" "/>
    </Grid>
</Window>
